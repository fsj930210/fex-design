{
  "name": "Dialog",
  "slug": "dialog",
  "layer": "primitive",
  "status": "experimental",
  "description": "提供跨框架一致的 Dialog 状态、Overlay、Content、标题、关闭和全屏部件。",
  "importPath": {
    "react": "@fex-design/react/primitive/dialog",
    "vue": "@fex-design/vue/primitive/dialog",
    "solid": "@fex-design/solid/primitive/dialog",
    "svelte": "@fex-design/svelte/primitive/dialog",
    "angular": "@fex-design/angular/primitive/dialog"
  },
  "props": [
    {
      "name": "open",
      "type": "boolean",
      "description": "受控打开状态。"
    },
    {
      "name": "defaultOpen",
      "type": "boolean",
      "default": "false",
      "description": "非受控初始打开状态。"
    },
    {
      "name": "modal",
      "type": "boolean",
      "default": "true",
      "description": "是否使用模态语义。"
    },
    {
      "name": "forceMount",
      "type": "boolean",
      "default": "false",
      "description": "关闭时是否保持 Portal 内容挂载。"
    },
    {
      "name": "closeDelay",
      "type": "number",
      "default": "200",
      "description": "关闭阶段持续时间。"
    },
    {
      "name": "closeOnEscape",
      "type": "boolean",
      "default": "true",
      "description": "是否允许 Escape 关闭。"
    },
    {
      "name": "closeOnOverlayClick",
      "type": "boolean",
      "default": "true",
      "description": "是否允许点击 Overlay 关闭。"
    },
    {
      "name": "fullscreen",
      "type": "boolean | { mode?: 'viewport' | 'screen' }",
      "description": "全屏配置。true 默认使用 viewport。"
    },
    {
      "name": "onOpenChange",
      "type": "(open, info) => void",
      "description": "打开状态变化回调。"
    },
    {
      "name": "onFullscreenChange",
      "type": "(fullscreen) => void",
      "description": "全屏状态变化回调。"
    }
  ],
  "events": [
    {
      "name": "onOpenChange",
      "parameters": [
        {
          "name": "open",
          "type": "boolean"
        },
        {
          "name": "info",
          "type": "DialogChangeInfo"
        }
      ],
      "description": "请求改变打开状态；受控模式由调用方同步 open。"
    },
    {
      "name": "onFullscreenChange",
      "parameters": [
        {
          "name": "fullscreen",
          "type": "boolean"
        }
      ],
      "description": "全屏状态改变后触发。"
    }
  ],
  "cssVariables": [
    {
      "name": "--dialog-header-background",
      "description": "标题区背景色，默认跟随主题背景色。"
    },
    {
      "name": "--dialog-content-background",
      "description": "正文区域及面板背景色，默认跟随主题背景色。"
    },
    {
      "name": "--dialog-footer-background",
      "description": "页脚背景色，默认跟随主题背景色。"
    },
    {
      "name": "--dialog-width",
      "description": "Content 宽度。"
    },
    {
      "name": "--dialog-height",
      "description": "Content 高度。"
    },
    {
      "name": "--dialog-z-index",
      "description": "Dialog 层级。"
    },
    {
      "name": "--dialog-motion-duration",
      "description": "动画时长。"
    },
    {
      "name": "--dialog-motion-ease",
      "description": "动画缓动函数。"
    },
    {
      "name": "--overlay-background",
      "description": "Overlay 背景。"
    }
  ],
  "demos": [
    {
      "id": "basic",
      "title": "基础使用"
    },
    {
      "id": "overlay",
      "title": "Overlay 行为"
    },
