{
  "name": "Pagination",
  "slug": "pagination",
  "layer": "primitive",
  "status": "draft",
  "description": "可组合分页部件。",
  "importPath": {
    "react": "@fex-design/react/primitive/pagination",
    "vue": "@fex-design/vue/primitive/pagination",
    "solid": "@fex-design/solid/primitive/pagination",
    "svelte": "@fex-design/svelte/primitive/pagination",
    "angular": "@fex-design/angular/primitive/pagination"
  },
  "props": [],
  "events": [],
  "slots": [],
  "components": [
    {
      "name": "PaginationRoot",
      "nativeElement": "nav",
      "description": "分页根容器。",
      "props": [
        {
          "name": "total",
          "type": "number",
          "description": "数据总条数。",
          "default": 0
        },
        {
          "name": "page",
          "type": "number",
          "description": "受控当前页，从 1 开始。"
        },
        {
          "name": "defaultPage",
          "type": "number",
          "description": "非受控初始页，仅初始化读取。",
          "default": 1
        },
        {
          "name": "pageSize",
          "type": "number",
          "description": "受控每页条数。"
        },
        {
          "name": "defaultPageSize",
          "type": "number",
          "description": "非受控初始每页条数，仅初始化读取。",
          "default": 10
        },
        {
          "name": "siblingCount",
          "type": "number",
          "description": "当前页两侧各保留的页码数量。",
          "default": 1
        },
        {
          "name": "boundaryCount",
          "type": "number",
          "description": "首尾各保留的页码数量。",
          "default": 1
        },
        {
          "name": "size",
          "type": "'sm' | 'md' | 'lg'",
          "description": "统一控制分页按钮、条数选择和跳页输入的尺寸。",
          "default": "md"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "description": "禁用所有分页修改。",
          "default": false
        },
        {
          "name": "labels",
          "type": "Partial<PaginationLabels>",
          "description": "自定义可访问名称、总数文字、条数选项和跳页前后缀。"
        }
      ],
      "events": [
        {
          "name": "onChange",
          "parameters": [
            {
              "name": "value",
              "type": "PaginationValue"
            },
            {
              "name": "details",
              "type": "PaginationChangeDetails"
            }
          ],
          "description": "分页变更；受控字段由调用方更新。"
        }
      ],
      "slots": [
        {
          "name": "default",
          "description": "组合分页部件或读取 snapshot。"
        }
      ],
      "frameworks": {
        "react": {
          "events": [
            {
              "name": "onChange",
              "parameters": [
                {
                  "name": "value",
                  "type": "PaginationValue"
                },
                {
                  "name": "details",
                  "type": "PaginationChangeDetails"
                }
              ],
              "description": "分页变更；受控字段由调用方更新。"
            }
          ]
        },
        "vue": {
          "events": [
            {
              "name": "change",
              "parameters": [
                {
                  "name": "value",
                  "type": "PaginationValue"
                },
                {
                  "name": "details",
                  "type": "PaginationChangeDetails"
                }
              ],
              "description": "分页变更。"
            },
            {
              "name": "update:page",
              "parameters": [
                {
                  "name": "page",
                  "type": "number"
                }
              ],
              "description": "支持 v-model:page。"
            },
            {
              "name": "update:pageSize",
              "parameters": [
                {
                  "name": "pageSize",
                  "type": "number"
                }
              ],
              "description": "支持 v-model:page-size。"
            }
          ]
        },
        "solid": {
          "events": [
            {
              "name": "onChange",
              "parameters": [
                {
                  "name": "value",
                  "type": "PaginationValue"
                },
                {
                  "name": "details",
                  "type": "PaginationChangeDetails"
                }
              ],
              "description": "分页变更；受控字段由调用方更新。"
            }
          ]
        },
        "svelte": {
          "events": [
            {
              "name": "onchange",
              "parameters": [
                {
                  "name": "value",
                  "type": "PaginationValue"
                },
                {
                  "name": "details",
                  "type": "PaginationChangeDetails"
                }
              ],
              "description": "分页变更；支持 bind:page 和 bind:pageSize。"
            }
          ]
        },
        "angular": {
          "events": [
            {
              "name": "change",
              "parameters": [
                {
                  "name": "event",
                  "type": "{ value: PaginationValue; details: PaginationChangeDetails }"
                }
              ],
              "description": "分页变更；受控字段由调用方更新。"
            }
          ]
        }
      },
