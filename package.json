{
  "name": "fex-design",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@fex-design/*-app --ui=stream --concurrency=100%",
    "dev:server": "turbo run dev --filter=@fex/server --ui=stream",
    "build:server": "turbo run build --filter=@fex/server",
    "start:server": "pnpm --dir server start:prod",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "turbo run lint typecheck build",
    "dev:react": "turbo run dev --filter=@fex-design/react-app --ui=stream",
    "dev:vue": "turbo run dev --filter=@fex-design/vue-app --ui=stream",
    "dev:solid": "turbo run dev --filter=@fex-design/solid-app --ui=stream",
    "dev:svelte": "turbo run dev --filter=@fex-design/svelte-app --ui=stream",
    "dev:angular": "turbo run dev --filter=@fex-design/angular-app --ui=stream"
  },
  "devDependencies": {
    "@fex/config-oxc": "workspace:*",
    "@fex/config-tsconfig": "workspace:*",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "turbo": "2.10.11"
  },
  "packageManager": "pnpm@11.19.0"
}
