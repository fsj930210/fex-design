{
  "name": "Form",
  "slug": "form",
  "layer": "primitive",
  "status": "draft",
  "description": "基于 TanStack Form 的表单语义部件。负责上下文、字段关联、布局与反馈，不接管控件值或事件。",
  "importPath": {
    "react": "@fex-design/react/primitive/form",
    "vue": "@fex-design/vue/primitive/form",
    "solid": "@fex-design/solid/primitive/form",
    "svelte": "@fex-design/svelte/primitive/form",
    "angular": "@fex-design/angular/primitive/form"
  },
  "props": [
    {
      "name": "form",
      "type": "TanStack FormApi",
      "required": true,
      "description": "FormRoot 组件的 form 属性：当前框架的 TanStack Form 实例。"
    },
    {
      "name": "component",
      "type": "'form' | false",
      "default": "form",
      "description": "FormRoot 组件是否输出原生 form；传 false 时只提供表单上下文。"
    },
    {
      "name": "scrollToFirstError",
      "type": "boolean | FormScrollOptions",
      "default": true,
      "description": "FormRoot 组件提交失败后是否滚动并聚焦首个错误。"
    },
    {
      "name": "layout",
      "type": "'vertical' | 'horizontal' | 'inline'",
      "default": "vertical",
      "description": "FormRoot 组件的内置表单布局。"
    },
    {
      "name": "labelAlign",
      "type": "'start' | 'end'",
      "default": "end",
      "description": "FormRoot 组件在横向/行内布局中的标签文本对齐。"
    },
    {
      "name": "labelWidth",
      "type": "string | number",
      "default": "7rem",
      "description": "FormRoot 组件的标签列宽。"
    },
    {
      "name": "labelGap",
      "type": "string | number",
      "default": "0.5rem",
      "description": "FormRoot 组件的标签与控件间距。"
    },
    {
      "name": "labelWrap",
      "type": "boolean",
      "default": false,
      "description": "FormRoot 组件是否允许长标签换行。"
    }
  ],
  "events": [],
  "slots": [],
  "components": [
    {
      "name": "FormField",
      "layer": "primitive",
      "description": "注册字段、建立标签/说明/错误关联，并提供字段上下文；不绑定控件值。",
      "props": [
        {
          "name": "name",
          "type": "DeepKeys<TData>",
          "required": true,
          "description": "对象或数组字段路径。"
        },
        {
          "name": "validators",
          "type": "TanStack field validators",
          "description": "TanStack 字段校验器。"
        },
        {
          "name": "listeners",
          "type": "TanStack field listeners",
          "description": "TanStack 字段监听器。"
        },
        {
          "name": "defaultValue",
          "type": "DeepValue<TData, TName>",
          "description": "字段默认值。"
        },
        {
          "name": "className",
          "type": "string",
          "description": "字段容器 class。"
        },
        {
          "name": "style",
          "type": "FrameworkStyle",
          "description": "字段容器 style。"
        }
      ],
      "frameworks": {
        "react": {
          "typeOverrides": {
            "FrameworkNode": "ReactNode",
            "FrameworkStyle": "CSSProperties"
          }
        },
        "vue": {
          "typeOverrides": {
            "FrameworkNode": "VNodeChild",
            "FrameworkStyle": "StyleValue"
          }
        },
        "solid": {
          "typeOverrides": {
            "FrameworkNode": "JSX.Element",
            "FrameworkStyle": "JSX.CSSProperties"
          }
        },
        "svelte": {
          "typeOverrides": {
            "FrameworkNode": "Snippet",
            "FrameworkStyle": "string"
          }
        },
        "angular": {
          "typeOverrides": {
            "FrameworkNode": "string | TemplateRef<unknown>",
            "FrameworkStyle": "string"
          }
        }
      }
    },
    {
      "name": "FormControl",
      "layer": "primitive",
      "description": "登记实际控件目标，关联标签、说明、错误和聚焦；不会注入 value 或事件。",
      "props": [
        {
          "name": "children",
          "type": "FrameworkNode",
          "description": "调用方显式绑定 value、change 和 blur 的控件。"
        }
      ],
      "frameworks": {
        "react": {
          "typeOverrides": {
