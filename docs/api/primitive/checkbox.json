{
  "name": "Checkbox",
  "slug": "checkbox",
  "layer": "primitive",
  "status": "stable",
  "description": "基于原生 checkbox 的可组合选择控件，提供独立的结构、标记、标签和组选项能力。",
  "importPath": {
    "react": "@fex-design/react/primitive/checkbox",
    "vue": "@fex-design/vue/primitive/checkbox",
    "solid": "@fex-design/solid/primitive/checkbox",
    "svelte": "@fex-design/svelte/primitive/checkbox",
    "angular": "@fex-design/angular/primitive/checkbox"
  },
  "props": [],
  "events": [],
  "cssVariables": [
    {
      "name": "--checkbox-size",
      "description": "方框边长。"
    },
    {
      "name": "--checkbox-background",
      "description": "未选中状态的背景色。"
    },
    {
      "name": "--checkbox-border-color",
      "description": "未选中状态的边框色。"
    },
    {
      "name": "--checkbox-checked-background",
      "description": "选中和中间状态的背景色。"
    },
    {
      "name": "--checkbox-checked-border-color",
      "description": "选中和中间状态的边框色；未设置时回退到选中背景色。"
    },
    {
      "name": "--checkbox-indicator-color",
      "description": "选中和中间状态标记的颜色。"
    },
    {
      "name": "--checkbox-ring-color",
      "description": "键盘聚焦环颜色。"
    },
    {
      "name": "--checkbox-content-gap",
      "description": "方框与标签内容之间的间距。"
    }
  ],
  "demos": [
    {
      "id": "basic",
      "title": "基础用法",
      "description": "未选中与默认选中的 Checkbox。"
    },
    {
      "id": "states",
      "title": "状态",
      "description": "对照未选中、已选中、中间状态和禁用状态。"
    },
    {
      "id": "sizes",
      "title": "尺寸",
      "description": "对照 sm、md 和 lg 三种尺寸。"
    },
    {
      "id": "controlled",
      "title": "受控与非受控",
      "description": "通过外部按钮设置受控状态，并对照非受控初始值。"
    },
    {
      "id": "group",
      "title": "CheckboxGroup",
      "description": "使用平级 value 数组管理一组选项。"
    },
    {
      "id": "check-all",
      "title": "全选",
      "description": "由业务选择结果计算 checked 和 indeterminate。"
    },
    {
      "id": "validation",
      "title": "校验失败",
      "description": "使用 aria-invalid，并通过 aria-describedby 关联错误说明。"
    },
    {
      "id": "custom-indicator",
      "title": "自定义 Indicator",
      "description": "替换选中状态使用的视觉标记。"
    },
    {
      "id": "direction",
      "title": "LTR 与 RTL",
      "description": "对照中文 LTR 与阿拉伯语 RTL 排列。"
    },
    {
      "id": "css-variables",
      "title": "实例 CSS Variables",
      "description": "覆盖单个 Checkbox 的尺寸、背景和标记颜色。"
    }
  ],
