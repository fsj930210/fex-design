{
  "name": "Progress Primitive",
  "slug": "progress-primitive",
  "layer": "primitive",
  "status": "stable",
  "description": "提供原子级 Progress 容器、轨道、填充条、文本、标签及圆环子组件，内置主题样式与平滑过渡，支持完全自由的布局组合。",
  "importPath": {
    "react": "@fex-design/react/primitive/progress",
    "vue": "@fex-design/vue/primitive/progress",
    "solid": "@fex-design/solid/primitive/progress",
    "svelte": "@fex-design/svelte/primitive/progress",
    "angular": "@fex-design/angular/primitive/progress"
  },
  "components": [
    {
      "name": "Progress",
      "description": "Progress Root 容器组件，负责注入 Context 与管理 progressbar ARIA 语义。",
      "props": [
        {
          "name": "value",
          "type": "number | null",
          "default": 0,
          "description": "当前进度值；null 表示尚未提供进度值，不触发动画"
        },
        {
          "name": "min",
          "type": "number",
          "default": 0,
          "description": "最小值"
        },
        {
          "name": "max",
          "type": "number",
          "default": 100,
          "description": "最大值"
        },
        {
          "name": "variant",
          "type": "'line' | 'circle' | 'dashboard'",
          "default": "'line'",
          "description": "进度条形态变体"
        },
        {
          "name": "status",
          "type": "'pending' | 'active' | 'success' | 'error'",
          "default": "'pending'",
          "description": "任务生命周期状态"
        }
      ],
      "frameworks": {
        "react": {
          "typeOverrides": {
            "FrameworkNode": "ReactNode"
          },
          "slots": []
        },
