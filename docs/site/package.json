{
  "name": "@fex-design/docs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ./scripts/generate-component-registry.mjs",
    "dev": "vite --host 127.0.0.1 --port 4100 --strictPort",
    "prebuild": "node ./scripts/generate-component-registry.mjs",
    "build": "node ./scripts/generate-example-sources.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "pretypecheck": "node ./scripts/generate-component-registry.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fex-design/docs-shared": "workspace:*",
    "@fex-design/components-styles": "workspace:*",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "catalog:",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "latest",
    "solid-js": "1.9.15",
    "solid-mdx": "^0.0.7",
    "vite": "catalog:",
    "vite-plugin-solid": "latest",
    "@fex-design/solid": "workspace:*",
    "@fex-design/styles": "workspace:*"
  },
  "devDependencies": {
    "@fex/config-tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
