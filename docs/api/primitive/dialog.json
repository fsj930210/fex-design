    {
      "id": "resize",
      "title": "调整弹窗尺寸"
    },
    {
      "id": "minimax",
      "title": "最小化与最大化"
    },
    {
      "id": "alert",
      "title": "提示弹窗"
    },
    {
      "id": "confirm",
      "title": "确认弹窗"
    },
    {
      "id": "methods",
      "title": "实例方法"
    },
    {
      "id": "direction",
      "title": "LTR 与 RTL"
    },
    {
      "id": "css-variables",
      "title": "CSS 变量",
      "height": 440
    },
    {
      "id": "semantic-styles",
      "title": "结构化样式",
      "height": 440
    }
  ],
  "frameworks": {
    "react": {
      "typeOverrides": {
        "FrameworkNode": "ReactNode",
        "FrameworkContent": "ReactNode"
      },
      "slots": []
    },
    "vue": {
