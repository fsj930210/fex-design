{
  "name": "InputNumber",
  "slug": "input-number",
  "layer": "primitive",
  "status": "stable",
  "description": "复用 Input 与 Button 的可组合数字输入。",
  "importPath": {
    "react": "@fex-design/react/primitive/input-number",
    "vue": "@fex-design/vue/primitive/input-number",
    "solid": "@fex-design/solid/primitive/input-number",
    "svelte": "@fex-design/svelte/primitive/input-number",
    "angular": "@fex-design/angular/primitive/input-number"
  },
  "components": [
    {
      "name": "InputNumberRoot",
      "layer": "primitive",
      "description": "管理 number、编辑文本、范围与步长。",
      "props": [],
      "events": [],
      "slots": [],
      "demos": []
    },
    {
      "name": "InputNumberControl",
      "layer": "primitive",
      "description": "复用 InputControl 的真实 input 和 spinbutton 语义。",
      "props": [],
      "events": [],
      "slots": [],
      "demos": []
    },
    {
      "name": "InputNumberClear",
      "layer": "primitive",
      "description": "复用 InputClear 并同步清空 number。",
      "props": [],
      "events": [],
      "slots": [],
      "demos": []
    },
    {
      "name": "InputNumberActions",
      "layer": "primitive",
      "description": "增减操作布局。",
      "props": [],
      "events": [],
      "slots": [],
      "demos": []
    },
    {
      "name": "InputNumberIncrement",
      "layer": "primitive",
      "description": "复用 Button 的增加操作，默认 PlusIcon 可替换。",
      "props": [],
      "events": [],
      "slots": [],
      "demos": []
    },
    {
      "name": "InputNumberDecrement",
      "layer": "primitive",
      "description": "复用 Button 的减少操作，默认 MinusIcon 可替换。",
      "props": [],
      "events": [],
      "slots": [],
      "demos": []
    },
    {
      "name": "useInputNumber",
      "layer": "primitive",
      "description": "各框架原生的数字输入逻辑实现，可用于组装自定义结构。",
      "props": [
        {
          "name": "value / defaultValue",
          "type": "number | undefined",
          "description": "受控值与非受控初始值。"
        },
        {
          "name": "min / max / step / precision",
          "type": "number",
          "description": "范围、步长与提交精度。"
        },
        {
          "name": "parser / formatter",
          "type": "InputNumberParser / InputNumberFormatter",
          "description": "分离编辑文本与 number 值。"
        },
        {
          "name": "disabled / readOnly / keyboard",
          "type": "boolean",
          "description": "控制编辑、操作与键盘步进。"
        },
        {
          "name": "onChange",
          "type": "(event: Event, value: number | undefined) => void",
          "description": "返回原始事件与 number。"
        },
        {
          "name": "state",
          "type": "value, draft, formattedValue, min, max, outOfRange",
          "description": "返回的状态与派生值。"
        },
        {
          "name": "availability",
          "type": "canClear, canIncrement, canDecrement",
          "description": "返回的操作可用性。"
        },
        {
          "name": "actions",
          "type": "input, blur, keydown, clear, increment, decrement, commit",
          "description": "返回的交互方法。"
        }
      ],
      "events": [],
      "slots": [],
      "demos": [{ "id": "custom-logic" }]
    }
  ],
  "props": [
    { "name": "value", "type": "number | undefined", "description": "受控数值。" },
    { "name": "defaultValue", "type": "number | undefined", "description": "非受控初始数值。" },
    { "name": "min", "type": "number", "description": "最小值。" },
    { "name": "max", "type": "number", "description": "最大值。" },
    { "name": "step", "type": "number", "default": 1, "description": "增减步长。" },
    { "name": "precision", "type": "number", "description": "提交精度。" },
    { "name": "parser", "type": "InputNumberParser", "description": "将编辑文本解析为 number。" },
    {
      "name": "formatter",
      "type": "InputNumberFormatter",
      "description": "将 number 格式化为展示文本。"
    },
    {
      "name": "keyboard",
      "type": "boolean",
      "default": true,
      "description": "是否允许方向键步进。"
    }
  ],
  "events": [
    {
      "name": "change",
      "parameters": [
        { "name": "event", "type": "Event" },
        { "name": "value", "type": "number | undefined" }
      ],
      "description": "输入、提交、清除或步进后返回原始事件与 number。"
    }
  ],
  "cssVariables": [],
  "demos": [
    { "id": "basic" },
    { "id": "constraints" },
    { "id": "formatter" },
    { "id": "editing" },
    { "id": "controls" },
    { "id": "keyboard" },
    { "id": "range" },
    { "id": "custom-logic" },
    { "id": "affixes" },
    { "id": "validation" }
  ]
}
