  "demos": [
    {
      "id": "basic",
      "title": "基本用法",
      "description": "只显示页码和前后翻页。"
    },
    {
      "id": "full",
      "title": "完整分页",
      "description": "总数、页码、每页条数和快捷跳页。"
    },
    {
      "id": "controlled",
      "title": "外部受控",
      "description": "外部设置页码、每页条数和总数，并查看变更反馈。"
    },
    {
      "id": "simple",
      "title": "简洁模式",
      "description": "当前页和总页数替换数字页码。"
    },
    {
      "id": "sizes",
      "title": "尺寸",
      "description": "小、中、大三种统一尺寸。"
    },
    {
      "id": "page-size-options",
      "title": "条数选项",
      "description": "使用 5、15、30 条选项与初始每页 15 条。"
    },
    {
      "id": "page-range",
      "title": "页码范围",
      "description": "对比不同的相邻页码和首尾页码数量。"
    },
    {
      "id": "disabled",
      "title": "禁用",
      "description": "禁止分页、条数选择与快捷跳页。"
    },
    {
      "id": "empty",
      "title": "空数据",
      "description": "普通与简洁模式的空数据状态。"
    },
    {
      "id": "hide-on-single-page",
      "title": "单页隐藏",
      "description": "切换总数，观察单页隐藏与多页显示。"
    },
    {
      "id": "custom",
      "title": "自定义内容",
      "description": "修改总数范围、页码和导航内容。"
    },
    {
      "id": "layout",
      "title": "总数布局",
      "description": "紧邻排列与总数独占一侧的布局。"
    },
    {
      "id": "direction",
      "title": "阅读方向",
      "description": "对比从左向右与从右向左的分页。"
    },
    {
      "id": "logic",
      "title": "usePagination",
      "description": "使用 usePagination 手写 DOM 实现自己的 Pagination。"
    },
    {
      "id": "css-variables",
      "title": "CSS 变量",
      "description": "修改控件高度、文字、间距、圆角和状态颜色。"
    },
    {
      "id": "semantic-styles",
      "title": "结构化样式",
