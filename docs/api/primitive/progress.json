  "components": [
    {
      "name": "Progress",
      "description": "Progress Root 容器组件，负责注入 Context 与管理 progressbar ARIA 语义。",
      "props": [
        {
          "name": "value",
          "type": "number | null",
          "default": 0,
          "description": "当前进度；null 表示没有数值。"
        },
        {
          "name": "min",
          "type": "number",
          "default": 0,
          "description": "最小值。"
        },
        {
          "name": "max",
          "type": "number",
          "default": 100,
          "description": "最大值。"
        },
        {
          "name": "variant",
          "type": "'line' | 'circle' | 'dashboard'",
          "default": "'line'",
          "description": "形态。"
        },
        {
          "name": "status",
          "type": "'pending' | 'active' | 'success' | 'error'",
          "default": "根据 value 推导",
          "description": "默认根据归一化进度推导状态。"
        },
        {
          "name": "size",
          "type": "number",
          "default": 48,
          "description": "圆环或仪表盘直径（像素）。"
        },
        {
          "name": "thickness",
          "type": "number",
          "default": "line: 8; circle/dashboard: 4",
          "description": "轨道高度或圆环描边宽度（像素）。"
        }
      ],
