{
  "name": "Dialog",
  "slug": "dialog",
  "layer": "ui",
  "status": "experimental",
  "description": "用于在当前页面上显示模态内容、确认操作和可组合窗口行为。",
  "importPath": {
    "react": "@fex-design/react/ui/dialog",
    "vue": "@fex-design/vue/ui/dialog",
    "solid": "@fex-design/solid/ui/dialog",
    "svelte": "@fex-design/svelte/ui/dialog",
    "angular": "@fex-design/angular/ui/dialog"
  },
  "props": [
    {
      "name": "open",
      "type": "boolean",
      "description": "受控打开状态。"
    },
    {
      "name": "defaultOpen",
      "type": "boolean",
      "default": "false",
      "description": "非受控模式的初始打开状态。"
    },
    {
      "name": "title",
      "type": "FrameworkContent",
      "description": "标题内容。"
    },
    {
      "name": "closable",
      "type": "boolean | { icon?: framework-native content | null; disabled?: boolean; onClose?: function }",
      "default": "true",
      "description": "是否显示右上角关闭按钮。"
    },
    {
      "name": "closeOnOverlayClick",
      "type": "boolean",
      "default": "true",
      "description": "是否允许点击 Overlay 关闭。"
    },
    {
      "name": "closeOnEscape",
      "type": "boolean",
      "default": "true",
      "description": "是否允许 Escape 关闭。"
    },
    {
      "name": "fullscreen",
      "type": "boolean | { mode?: 'viewport' | 'screen' }",
      "description": "启用 UI 全屏状态；true 默认使用 viewport。"
    },
    {
      "name": "footer",
      "type": "FrameworkNode | null",
      "description": "Footer 内容；传入 null 隐藏默认 Footer。"
    },
    {
      "name": "classNames",
      "type": "DialogClassNames",
      "description": "按语义区域设置 class。"
    },
    {
      "name": "styles",
      "type": "DialogStyles",
      "description": "按语义区域设置 style。"
    },
    {
      "name": "onOpenChange",
      "type": "(open, info) => void",
      "description": "打开状态变化回调。"
    },
    {
      "name": "onFullscreenChange",
      "type": "(fullscreen) => void",
      "description": "全屏状态变化回调。"
    },
    {
      "name": "okBtnProps",
      "type": "ButtonProps",
      "description": "默认操作按钮的属性与内容配置。"
    },
    {
      "name": "cancelBtnProps",
      "type": "ButtonProps",
      "description": "默认操作按钮的属性与内容配置。"
    },
    {
      "name": "forceMount",
      "type": "boolean",
      "default": "false",
      "description": "关闭时保留挂载。"
    },
    {
      "name": "closeDelay",
      "type": "number",
      "default": "200",
      "description": "关闭动画的卸载延迟（毫秒）。"
    },
    {
      "name": "modal",
      "type": "boolean",
      "default": "true",
      "description": "是否使用模态语义。与 overlay 分别配置：modal 控制模态行为，overlay 控制背景遮罩。"
    }
  ],
  "events": [
    {
      "name": "onOpenChange",
      "parameters": [
        {
          "name": "open",
          "type": "boolean"
        },
        {
          "name": "info",
          "type": "DialogChangeInfo"
        }
      ],
      "description": "请求改变打开状态；受控模式由调用方同步 open。"
    },
    {
      "name": "onFullscreenChange",
      "parameters": [
        {
          "name": "fullscreen",
          "type": "boolean"
        }
      ],
      "description": "全屏状态改变后触发。"
    }
  ],
  "cssVariables": [
    {
      "name": "--dialog-header-background",
      "description": "标题区背景色，默认跟随主题背景色。"
    },
    {
      "name": "--dialog-content-background",
      "description": "正文区域及面板背景色，默认跟随主题背景色。"
    },
    {
      "name": "--dialog-footer-background",
      "description": "页脚背景色，默认跟随主题背景色。"
    },
    {
      "name": "--dialog-width",
      "description": "Content 宽度。"
    },
    {
      "name": "--dialog-height",
      "description": "Content 高度。"
    },
    {
      "name": "--dialog-z-index",
      "description": "Dialog 层级。"
    },
    {
      "name": "--dialog-motion-duration",
      "description": "动画时长。"
    },
    {
      "name": "--dialog-motion-ease",
      "description": "动画缓动函数。"
    },
    {
      "name": "--overlay-background",
      "description": "Overlay 背景。"
    }
  ],
  "demos": [
    {
      "id": "basic",
      "title": "基础使用"
    },
    {
      "id": "overlay",
      "title": "Overlay 行为"
    },
    {
      "id": "close-delay",
      "title": "关闭延迟"
    },
    {
      "id": "custom-header",
      "title": "自定义 Header"
    },
    {
      "id": "custom-footer",
      "title": "自定义 Footer"
    },
    {
      "id": "fullscreen",
      "title": "全屏"
    },
    {
      "id": "position",
      "title": "自定义位置"
    },
    {
      "id": "form",
      "title": "表单弹窗"
    },
    {
      "id": "nested",
      "title": "嵌套弹窗"
    },
    {
      "id": "draggable",
      "title": "拖拽弹窗"
    },
    {
      "id": "resize",
      "title": "调整弹窗尺寸"
    },
    {
      "id": "minimax",
      "title": "最小化与最大化"
    },
    {
      "id": "alert",
      "title": "提示弹窗"
    },
    {
      "id": "confirm",
      "title": "确认弹窗"
    },
    {
      "id": "methods",
      "title": "实例方法"
    },
    {
      "id": "direction",
      "title": "LTR 与 RTL"
    },
    {
      "id": "css-variables",
      "title": "CSS 变量",
      "height": 440
    },
    {
      "id": "semantic-styles",
      "title": "结构化样式",
      "height": 440
    }
  ],
  "frameworks": {
    "react": {
      "typeOverrides": {
        "FrameworkNode": "ReactNode",
        "FrameworkContent": "ReactNode"
      },
      "slots": []
    },
    "vue": {
      "events": [
        {
          "name": "update:open",
          "parameters": [
            {
              "name": "open",
              "type": "boolean"
            }
          ],
          "description": "用于 v-model:open。"
        },
        {
          "name": "openChange",
          "parameters": [
            {
              "name": "open",
              "type": "boolean"
            },
            {
              "name": "info",
              "type": "DialogChangeInfo"
            }
          ],
          "description": "开关请求。"
        }
      ],
      "typeOverrides": {
        "FrameworkContent": "string",
        "FrameworkTitle": "string",
        "FrameworkNode": "string"
      }
    },
    "solid": {
      "typeOverrides": {
        "FrameworkNode": "JSX.Element",
        "FrameworkContent": "JSX.Element"
      },
      "slots": []
    },
    "svelte": {
      "typeOverrides": {
        "FrameworkNode": "Snippet",
        "FrameworkContent": "Snippet"
      },
      "slots": [
        {
          "name": "children",
          "description": "Dialog 内容。"
        },
        {
          "name": "footer",
          "description": "替换 Footer。"
        }
      ]
    },
    "angular": {
      "events": [
        {
          "name": "openChange",
          "parameters": [
            {
              "name": "open",
              "type": "boolean"
            }
          ],
          "description": "开关请求。"
        },
        {
          "name": "fullscreenChange",
          "parameters": [
            {
              "name": "fullscreen",
              "type": "boolean"
            }
          ],
          "description": "全屏状态改变。"
        }
      ],
      "typeOverrides": {
        "FrameworkContent": "string | TemplateRef<unknown>",
        "FrameworkTitle": "string | TemplateRef<unknown>",
        "FrameworkNode": "string | TemplateRef<unknown>"
      }
    }
  },
  "instance": {
    "title": "alert / confirm",
    "description": "React、Vue、Solid、Svelte：Dialog.alert / Dialog.confirm 或具名导入。Angular：DialogService.alert / DialogService.confirm。",
    "methods": [
      {
        "name": "alert(options?: DialogStaticOptions): DialogRequestHandle",
        "description": "提示弹窗，仅显示确定按钮。"
      },
      {
        "name": "confirm(options?: DialogStaticOptions): DialogRequestHandle",
        "description": "确认弹窗，显示取消和确定按钮。"
      },
      {
        "name": "destroyAll(): void",
        "description": "销毁全部通过 alert / confirm 创建的弹窗，不影响声明式 Dialog。"
      }
    ]
  },
  "types": [
    {
      "name": "DialogStaticOptions",
      "props": [
        {
          "name": "title",
          "type": "DialogStaticContent",
          "default": "alert: 提示；confirm: 确认操作",
          "description": "标题，支持自定义渲染内容。"
        },
        {
          "name": "content",
          "type": "DialogStaticContent",
          "description": "正文，必填，支持自定义渲染内容。"
        },
        {
          "name": "closable",
          "type": "boolean",
          "default": "alert: false；confirm: true",
          "description": "是否显示关闭按钮。"
        },
        {
          "name": "okBtnProps",
          "type": "DialogButtonProps",
          "description": "确定按钮属性。点击行为由 onOk 处理。"
        },
        {
          "name": "cancelBtnProps",
          "type": "DialogButtonProps",
          "description": "取消按钮属性，仅 confirm 有效。点击行为由 onCancel 处理。"
        },
        {
          "name": "onOk",
          "type": "() => void | boolean | Promise<void | boolean>",
          "description": "确认回调。返回 false 保持打开；抛错显示错误。"
        },
        {
          "name": "onCancel",
          "type": "() => void | boolean | Promise<void | boolean>",
          "description": "取消及关闭按钮回调。返回 false 保持打开；抛错显示错误。"
        }
      ],
      "frameworks": {
        "react": {
          "typeOverrides": {
            "DialogStaticContent": "ReactNode",
            "DialogButtonProps": "ButtonProps"
          }
        },
        "vue": {
          "typeOverrides": {
            "DialogStaticContent": "VNodeChild | (() => VNodeChild)",
            "DialogButtonProps": "ButtonProps & { content?: string }"
          }
        },
        "solid": {
          "typeOverrides": {
            "DialogStaticContent": "JSX.Element",
            "DialogButtonProps": "ButtonProps"
          }
        },
        "svelte": {
          "typeOverrides": {
            "DialogStaticContent": "string | Snippet",
            "DialogButtonProps": "ButtonProps"
          }
        },
        "angular": {
          "typeOverrides": {
            "DialogStaticContent": "string | TemplateRef<unknown>",
            "DialogButtonProps": "DialogStaticButtonProps"
          }
        }
      }
    },
    {
      "name": "DialogRequestHandle",
      "props": [
        {
          "name": "result",
          "type": "Promise<boolean>",
          "description": "确认后解析为 true；取消或销毁后解析为 false。"
        },
        {
          "name": "destroy",
          "type": "() => void",
          "description": "销毁当前弹窗，不触发 onCancel。重复调用无效。"
        },
        {
          "name": "update",
          "type": "(patch: Partial<DialogStaticOptions> | ((previous: Readonly<DialogStaticOptions>) => Partial<DialogStaticOptions>)) => void",
          "description": "合并更新标题、正文、按钮和回调。销毁后不再更新。"
        },
        {
          "name": "close",
          "type": "() => void",
          "description": "destroy 的别名。"
        }
      ]
    }
  ]
}
