              "type": "boolean"
            },
            {
              "name": "info",
              "type": "DialogChangeInfo"
            }
          ],
          "description": "开关请求。"
        }
      ],
      "typeOverrides": {
        "FrameworkContent": "string",
        "FrameworkTitle": "string",
        "FrameworkNode": "string"
      }
    },
    "solid": {
      "typeOverrides": {
        "FrameworkNode": "JSX.Element",
        "FrameworkContent": "JSX.Element"
      },
      "slots": []
    },
    "svelte": {
      "typeOverrides": {
        "FrameworkNode": "Snippet",
        "FrameworkContent": "Snippet"
      },
      "slots": []
    },
    "angular": {
      "events": [
        {
          "name": "openChange",
          "parameters": [
            {
              "name": "open",
              "type": "boolean"
            }
          ],
          "description": "开关请求。"
        },
        {
          "name": "fullscreenChange",
          "parameters": [
            {
              "name": "fullscreen",
              "type": "boolean"
            }
          ],
          "description": "全屏状态改变。"
        }
      ],
      "typeOverrides": {
        "FrameworkContent": "string | TemplateRef<unknown>",
        "FrameworkTitle": "string | TemplateRef<unknown>",
        "FrameworkNode": "string | TemplateRef<unknown>"
      }
    }
  },
