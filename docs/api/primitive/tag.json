    { "name": "color", "type": "TagColor", "description": "primary、success、warning、danger、info 或任意 CSS 颜色。" },
    { "name": "size", "type": "'sm' | 'md' | 'lg'", "default": "md", "description": "标签尺寸。", "editor": "enum", "options": ["sm", "md", "lg"] },
