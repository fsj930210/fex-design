{
  "name": "Skeleton",
  "slug": "skeleton",
  "layer": "ui",
  "status": "stable",
  "description": "组合骨架、loading 容器以及 Primitive 重导出。",
  "importPath": {
    "react": "@fex-design/react/ui/skeleton",
    "vue": "@fex-design/vue/ui/skeleton",
    "solid": "@fex-design/solid/ui/skeleton",
    "svelte": "@fex-design/svelte/ui/skeleton",
    "angular": "@fex-design/angular/ui/skeleton"
  },
  "props": [
    { "name": "loading", "type": "boolean", "description": "为 false 时显示子内容。" },
    { "name": "animation", "type": "'none' | 'pulse' | 'wave'", "default": "'none'", "description": "传递给内部占位组件。" },
    { "name": "avatar", "type": "boolean | SkeletonAvatarOptions", "default": "false", "description": "头像快捷配置。" },
    { "name": "title", "type": "boolean | { width?: number | string }", "default": "true", "description": "标题占位配置。" },
    { "name": "paragraph", "type": "boolean | { rows?: number; width?: SkeletonWidth | SkeletonWidth[] }", "default": "true", "description": "段落行数和宽度。" },
    { "name": "round", "type": "boolean", "default": "false", "description": "标题和段落使用全圆角。" },
    { "name": "classNames", "type": "Partial<Record<'root' | 'avatar' | 'title' | 'paragraph', string>>", "description": "结构化类名。" },
    { "name": "styles", "type": "SkeletonStyles", "description": "结构化行内样式。" }
  ],
  "events": [],
  "slots": [
    { "name": "default", "description": "loading 为 false 时显示的真实内容。" },
    { "name": "placeholder", "description": "覆盖自动生成结构的自定义骨架。" }
  ],
  "frameworks": {
    "react": { "slotLabel": "Content" },
    "vue": { "slotLabel": "Slots" },
    "solid": { "slotLabel": "Content" },
    "svelte": { "slotLabel": "Snippets" },
    "angular": { "slotLabel": "Content projection / template", "slots": [{ "name": "ng-content", "description": "真实内容。" }, { "name": "ng-template[skeletonPlaceholder]", "description": "自定义骨架模板。" }] }
  },
  "cssVariables": [],
  "demos": [
    { "id": "basic", "title": "基本", "description": "单独使用占位组件。" },
    { "id": "list", "title": "列表", "description": "列表骨架。" },
    { "id": "table", "title": "表格", "description": "表格骨架。" },
    { "id": "image", "title": "图片内容", "description": "图片内容骨架。" },
    { "id": "form", "title": "表单", "description": "表单骨架。" },
    { "id": "animation", "title": "动画", "description": "动画模式。" },
    { "id": "content", "title": "子内容与 loading", "description": "切换骨架和真实内容。" },
    { "id": "width", "title": "宽度配置", "description": "标题和段落宽度。" },
    { "id": "styles", "title": "结构化样式", "description": "四个语义区域。" }
  ]
}
