{
  "name": "Radio",
  "slug": "radio",
  "layer": "ui",
  "status": "stable",
  "description": "带标签、options 和按钮式快捷组合的单选控件。",
  "importPath": {
    "react": "@fex-design/react/ui/radio",
    "vue": "@fex-design/vue/ui/radio",
    "solid": "@fex-design/solid/ui/radio",
    "svelte": "@fex-design/svelte/ui/radio",
    "angular": "@fex-design/angular/ui/radio"
  },
  "props": [
    {
      "name": "value",
      "type": "string | number",
      "description": "当前选项值。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "禁用当前选项。",
      "editor": "boolean"
    },
    {
      "name": "size",
      "type": "'sm' | 'md' | 'lg'",
      "default": "md",
      "description": "选项尺寸。",
      "editor": "enum",
      "options": ["sm", "md", "lg"]
    },
    {
      "name": "classNames",
      "type": "Partial<Record<RadioPart, string>>",
      "description": "分别设置 root、control 和 label 的 class。"
    },
    {
      "name": "styles",
      "type": "Partial<Record<RadioPart, FrameworkStyle>>",
      "description": "分别设置 root、control 和 label 的内联样式。"
    }
  ],
  "events": [],
  "cssVariables": [
    {
      "name": "--radio-size",
      "description": "圆形 Radio 的边长。"
    },
    {
      "name": "--radio-indicator-size",
      "description": "选中圆点的边长，默认是控件尺寸的 50%。"
    },
    {
      "name": "--radio-border-color",
      "description": "未选中状态的边框色。"
    },
    {
      "name": "--radio-background",
      "description": "圆形 Radio 的背景色。"
    },
    {
      "name": "--radio-checked-color",
      "description": "选中状态的边框和圆点颜色。"
    },
    {
      "name": "--radio-ring-color",
      "description": "圆形 Radio 的键盘聚焦环颜色。"
    },
    {
      "name": "--radio-content-gap",
      "description": "UI Radio 控件与标签之间的间距。"
    },
    {
      "name": "--radio-button-height",
      "description": "RadioButton 高度。"
    },
    {
      "name": "--radio-button-padding-inline",
      "description": "RadioButton 水平内边距。"
    },
    {
      "name": "--radio-button-border-color",
      "description": "RadioButton 未选中边框色。"
    },
    {
      "name": "--radio-button-background",
      "description": "RadioButton 未选中背景色。"
    },
    {
      "name": "--radio-button-checked-background",
      "description": "RadioButton 选中背景和边框色。"
    },
    {
      "name": "--radio-button-checked-foreground",
      "description": "RadioButton 选中文字颜色。"
    },
    {
      "name": "--radio-button-ring-color",
      "description": "RadioButton 键盘聚焦环颜色。"
    }
  ],
  "demos": [
    {
      "id": "basic",
      "title": "基础用法",
      "description": "在 RadioGroup 中选择一个值。"
    },
    {
      "id": "states",
      "title": "状态",
      "description": "对照未选中、已选中和禁用状态。"
    },
    {
      "id": "sizes",
      "title": "尺寸",
      "description": "对照 sm、md 和 lg 三种尺寸。"
    },
    {
      "id": "controlled",
      "title": "受控与非受控",
      "description": "通过外部按钮修改受控值，并对照非受控初始值。"
    },
    {
      "id": "direction",
      "title": "LTR 与 RTL",
      "description": "对照中文 LTR 与阿拉伯语 RTL 排列。"
    },
    {
      "id": "css-variables",
      "title": "实例 CSS Variables",
      "description": "覆盖单个 Radio 和 RadioButton 的尺寸与颜色。"
    },
    {
      "id": "semantic-styles",
      "title": "结构化样式",
      "description": "分别设置 root、control 和 label 的样式。"
    }
  ],
  "frameworks": {
    "react": {
      "typeOverrides": {
        "FrameworkStyle": "CSSProperties"
      }
    },
    "vue": {
      "typeOverrides": {
        "FrameworkStyle": "StyleValue"
      }
    },
    "solid": {
      "typeOverrides": {
        "FrameworkStyle": "JSX.CSSProperties"
      }
    },
    "svelte": {
      "typeOverrides": {
        "FrameworkStyle": "string"
      }
    },
    "angular": {
      "typeOverrides": {
        "FrameworkStyle": "string"
      }
    }
  },
  "components": [
