        "angular": "@fex-design/angular/ui/radio"
      },
      "props": [
        {
          "name": "value",
          "type": "string | number",
          "description": "受控选中值。"
        },
        {
          "name": "defaultValue",
          "type": "string | number",
          "description": "非受控初始选中值。"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": false,
          "description": "禁用组内所有选项。",
          "editor": "boolean"
        },
        {
          "name": "options",
          "type": "RadioOption[]",
          "description": "快捷选项列表。"
        }
      ],
      "events": [],
      "slots": [],
      "demos": []
