{
  "name": "Slider",
  "slug": "slider",
  "layer": "ui",
  "status": "stable",
  "description": "自动组装轨道、范围、Thumb 和 Marks 的 Slider。",
  "importPath": {
    "react": "@fex-design/react/ui/slider",
    "vue": "@fex-design/vue/ui/slider",
    "solid": "@fex-design/solid/ui/slider",
    "svelte": "@fex-design/svelte/ui/slider",
    "angular": "@fex-design/angular/ui/slider"
  },
  "props": [
    {
      "name": "value",
      "type": "number | readonly number[]",
      "description": "受控单值或多节点值。"
    },
    {
      "name": "defaultValue",
      "type": "number | readonly number[]",
      "description": "非受控初始值。"
    },
    { "name": "min", "type": "number", "default": 0, "description": "最小值。" },
    { "name": "max", "type": "number", "default": 100, "description": "最大值。" },
    {
      "name": "step",
      "type": "number | null",
      "default": 1,
      "description": "步长；null 时只选择 Marks。"
    },
    {
      "name": "marks",
      "type": "readonly SliderMarkItem[]",
      "description": "可动态更新的刻度数据。"
    },
    { "name": "dots", "type": "boolean", "default": false, "description": "显示所有 step 点。" },
    {
      "name": "included",
      "type": "boolean",
      "default": true,
      "description": "是否绘制连续选中范围。"
    },
    {
      "name": "orientation",
      "type": "'horizontal' | 'vertical'",
      "default": "horizontal",
      "description": "方向。"
    },
    { "name": "direction", "type": "'ltr' | 'rtl'", "default": "ltr", "description": "文字与键盘方向。" },
    { "name": "reverse", "type": "boolean", "default": false, "description": "反转数值方向。" },
    {
      "name": "disabled",
      "type": "boolean | readonly boolean[]",
      "default": false,
      "description": "禁用全部或分别禁用 Thumb。"
    },
    {
      "name": "keyboard",
      "type": "boolean",
      "default": true,
      "description": "是否允许键盘改变值。"
    },
    {
      "name": "minStepsBetweenThumbs",
      "type": "number",
      "default": 0,
      "description": "相邻 Thumb 至少间隔的 step 数。"
    },
    {
      "name": "draggableRange",
      "type": "boolean",
      "default": false,
      "description": "允许整体拖动范围。"
    },
    {
      "name": "editable",
      "type": "boolean",
      "default": false,
      "description": "允许增加和删除节点。"
    },
    { "name": "minCount", "type": "number", "default": 0, "description": "最少节点数。" },
    { "name": "maxCount", "type": "number", "description": "最多节点数。" },
    { "name": "size", "type": "'sm' | 'md' | 'lg'", "default": "md", "description": "尺寸。" },
    {
      "name": "classNames",
      "type": "Partial<Record<SliderPart, string>>",
      "description": "按 root、track、range、thumb、mark 设置 class。"
    },
    {
      "name": "styles",
      "type": "Partial<Record<SliderPart, FrameworkStyle>>",
      "description": "按语义部位设置行内样式。"
    }
  ],
  "events": [
    { "name": "change", "parameters": [{ "name": "value", "type": "number | number[]" }, { "name": "meta", "type": "SliderChangeMeta" }], "description": "用户改变值时实时触发。" },
    { "name": "end", "parameters": [{ "name": "value", "type": "number | number[]" }, { "name": "meta", "type": "SliderChangeMeta" }], "description": "一次指针或键盘交互结束后触发。" }
  ],
  "demos": [
    { "id": "basic", "title": "基础用法", "description": "单值、受控与非受控 Slider，并区分 change 与 end。" },
    { "id": "weight", "title": "权重分配", "description": "一个值派生左右占比，并为两侧使用不同颜色。" },
    { "id": "range", "title": "范围与多节点", "description": "数组值自动生成多个 Thumb。" },
    { "id": "disabled", "title": "禁用状态", "description": "整体禁用和按索引禁用 Thumb。" },
    { "id": "draggable-range", "title": "范围可拖拽", "description": "整体移动由相邻 Thumb 界定的范围。" },
    { "id": "editable", "title": "动态增删节点", "description": "配合 minCount 与 maxCount 约束节点数量。" },
    { "id": "marks", "title": "动态刻度", "description": "展示 included、marks、dots 与 step=null 的组合。" },
    { "id": "direction", "title": "方向", "description": "对照 horizontal、vertical、LTR、RTL 与 reverse。" },
    { "id": "sizes", "title": "尺寸", "description": "对照 sm、md 与 lg 三种尺寸。" },
    { "id": "css-variables", "title": "实例 CSS Variables", "description": "覆盖单个 Slider 的轨道、范围和 Thumb 变量。" },
    { "id": "semantic-styles", "title": "结构化样式", "description": "通过 classNames 和 styles 定制语义部位。" }
  ],
  "cssVariables": [
    { "name": "--slider-track-height", "description": "轨道厚度。" },
    { "name": "--slider-track-background", "description": "轨道背景。" },
    { "name": "--slider-range-background", "description": "范围背景。" },
    { "name": "--slider-thumb-size", "description": "Thumb 尺寸。" },
    { "name": "--slider-thumb-background", "description": "Thumb 背景。" },
    { "name": "--slider-thumb-border-color", "description": "Thumb 边框。" }
  ],
  "frameworks": {
    "react": { "typeOverrides": { "FrameworkStyle": "CSSProperties" }, "events": [{ "name": "onChange", "parameters": [{ "name": "value", "type": "number | number[]" }, { "name": "meta", "type": "SliderChangeMeta" }], "description": "值变化时实时触发。" }, { "name": "onEnd", "parameters": [{ "name": "value", "type": "number | number[]" }, { "name": "meta", "type": "SliderChangeMeta" }], "description": "一次交互结束后触发。" }] },
    "vue": { "typeOverrides": { "FrameworkStyle": "StyleValue" }, "events": [{ "name": "change", "parameters": [{ "name": "value", "type": "number | number[]" }, { "name": "meta", "type": "SliderChangeMeta" }], "description": "值变化时实时触发。" }, { "name": "end", "parameters": [{ "name": "value", "type": "number | number[]" }, { "name": "meta", "type": "SliderChangeMeta" }], "description": "一次交互结束后触发。" }] },
    "solid": { "typeOverrides": { "FrameworkStyle": "JSX.CSSProperties" }, "events": [{ "name": "onChange", "parameters": [{ "name": "value", "type": "number | number[]" }, { "name": "meta", "type": "SliderChangeMeta" }], "description": "值变化时实时触发。" }, { "name": "onEnd", "parameters": [{ "name": "value", "type": "number | number[]" }, { "name": "meta", "type": "SliderChangeMeta" }], "description": "一次交互结束后触发。" }] },
    "svelte": { "typeOverrides": { "FrameworkStyle": "string" }, "events": [{ "name": "onChange", "parameters": [{ "name": "value", "type": "number | number[]" }, { "name": "meta", "type": "SliderChangeMeta" }], "description": "值变化时实时触发。" }, { "name": "onEnd", "parameters": [{ "name": "value", "type": "number | number[]" }, { "name": "meta", "type": "SliderChangeMeta" }], "description": "一次交互结束后触发。" }] },
    "angular": { "typeOverrides": { "FrameworkStyle": "string" }, "events": [{ "name": "change", "parameters": [{ "name": "event", "type": "{ value: number | number[]; meta: SliderChangeMeta }" }], "description": "值变化时输出 value 与 meta。" }, { "name": "end", "parameters": [{ "name": "event", "type": "{ value: number | number[]; meta: SliderChangeMeta }" }], "description": "交互结束时输出 value 与 meta。" }] }
  }
}
