{
  "name": "Anchor",
  "slug": "anchor",
  "layer": "ui",
  "status": "stable",
  "description": "通过 items 快速生成完整 Anchor，并支持结构化样式。",
  "importPath": { "react": "@fex-design/react/ui/anchor", "vue": "@fex-design/vue/ui/anchor", "solid": "@fex-design/solid/ui/anchor", "svelte": "@fex-design/svelte/ui/anchor", "angular": "@fex-design/angular/ui/anchor" },
  "props": [
    { "name": "items", "type": "readonly AnchorItem[]", "description": "Anchor 项目与嵌套结构。" },
    { "name": "activeKeys", "type": "readonly string[]", "description": "受控激活项。" },
    { "name": "defaultActiveKeys", "type": "readonly string[]", "default": "[]", "description": "非受控初始激活项。" },
    { "name": "activeMode", "type": "'current' | 'progress'", "default": "'current'", "description": "单项或连续进度高亮。" },
    { "name": "orientation", "type": "'vertical' | 'horizontal'", "default": "'vertical'", "description": "排列方向。" },
    { "name": "container", "type": "Window | HTMLElement | (() => Window | HTMLElement)", "default": "window", "description": "滚动容器。" },
    { "name": "targetOffset", "type": "number", "default": "0", "description": "默认目标滚动偏移。" },
    { "name": "threshold", "type": "number", "default": "16", "description": "目标距离容器顶部多少像素时切换激活项。" },
    { "name": "behavior", "type": "ScrollBehavior", "default": "'smooth'", "description": "滚动行为。" },
    { "name": "classNames", "type": "Partial<Record<AnchorPart, string>>", "description": "root、list、item、link、rail、indicator 的 class。" },
    { "name": "styles", "type": "Partial<Record<AnchorPart, FrameworkStyle>>", "description": "root、list、item、link、rail、indicator 的内联样式。" }
  ],
  "events": [
    { "name": "change", "type": "(activeKeys, items) => void", "description": "激活项改变。" },
    { "name": "itemClick", "type": "(event, item) => void", "description": "单项原生点击；调用 preventDefault() 可阻止内部滚动。" }
  ],
  "cssVariables": [],
  "demos": [
    { "id": "basic", "title": "基础用法", "description": "通过 items 快速创建 Anchor。" },
    { "id": "horizontal", "title": "横向", "description": "横向排列一级项目。" },
    { "id": "progress", "title": "Progress", "description": "连续高亮阅读进度。" },
    { "id": "controlled", "title": "受控与非受控", "description": "对照两种状态模式。" },
    { "id": "offset", "title": "自定义 Offset", "description": "单项偏移覆盖根偏移。" },
    { "id": "direction", "title": "LTR 与 RTL", "description": "验证逻辑方向。" },
    { "id": "custom-click", "title": "自定义 onClick", "description": "处理单项点击并可阻止内部滚动。" },
    { "id": "semantic-styles", "title": "结构化样式", "description": "定制全部语义部件。" }
  ],
  "frameworks": {
    "react": { "typeOverrides": { "FrameworkStyle": "CSSProperties" } },
    "vue": { "typeOverrides": { "FrameworkStyle": "StyleValue" } },
    "solid": { "typeOverrides": { "FrameworkStyle": "JSX.CSSProperties" } },
    "svelte": { "typeOverrides": { "FrameworkStyle": "string" } },
    "angular": { "typeOverrides": { "FrameworkStyle": "string" } }
  }
}
