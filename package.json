{
  "name": "fex-design",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@fex-design/*-app --ui=stream --concurrency=100%",
    "dev:server": "turbo run dev --filter=@fex/server --ui=stream",
    "build:server": "turbo run build --filter=@fex/server",
    "start:server": "pnpm --dir server start:prod",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "oxfmt . && prettier --write \"apps/**/*.svelte\" \"packages/**/*.svelte\" \"docs/**/*.svelte\" --plugin=prettier-plugin-svelte",
    "format:check": "oxfmt --check . && prettier --check \"apps/**/*.svelte\" \"packages/**/*.svelte\" \"docs/**/*.svelte\" --plugin=prettier-plugin-svelte",
    "check": "turbo run lint typecheck build",
    "dev:react": "turbo run dev --filter=@fex-design/react-app --ui=stream",
    "dev:vue": "turbo run dev --filter=@fex-design/vue-app --ui=stream",
    "dev:solid": "turbo run dev --filter=@fex-design/solid-app --ui=stream",
    "dev:svelte": "turbo run dev --filter=@fex-design/svelte-app --ui=stream",
    "dev:angular": "turbo run dev --filter=@fex-design/angular-app --ui=stream",
    "docs:dev": "turbo run dev --filter=@fex-design/docs-site --filter=@fex-design/docs-preview-* --ui=stream --concurrency=100%",
    "dev:docs": "pnpm run docs:dev",
    "dev:docs:solid": "turbo run dev --filter=@fex-design/docs-preview-solid --ui=stream",
    "build:docs": "node ./scripts/build-docs.mjs",
    "docs:build": "pnpm run build:docs",
    "docs:preview": "pnpm --dir docs/site preview",
    "icons:build": "pnpm --filter=@fex-design/icons build",
    "icons:dev": "pnpm --filter=@fex-design/icons dev"
  },
  "devDependencies": {
    "@fex/config-oxc": "workspace:*",
    "@fex/config-tsconfig": "workspace:*",
    "oxfmt": "0.67.0",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "turbo": "2.10.12"
  },
  "packageManager": "pnpm@11.19.0"
}
