{
  "name": "InputNumber",
  "slug": "input-number",
  "layer": "ui",
  "status": "stable",
  "description": "默认组装的数字输入快捷组件。",
  "importPath": {
    "react": "@fex-design/react/ui/input-number",
    "vue": "@fex-design/vue/ui/input-number",
    "solid": "@fex-design/solid/ui/input-number",
    "svelte": "@fex-design/svelte/ui/input-number",
    "angular": "@fex-design/angular/ui/input-number"
  },
  "components": [
    {
      "name": "InputNumber",
      "layer": "ui",
      "description": "使用默认 Control、Clear、Suffix 与增减操作的快捷组件。",
      "props": [],
      "events": [],
      "slots": [],
      "demos": []
    }
  ],
  "props": [
    { "name": "value", "type": "number | undefined", "description": "受控数值。" },
    { "name": "defaultValue", "type": "number | undefined", "description": "非受控初始数值。" },
    { "name": "min", "type": "number", "description": "最小值。" },
    { "name": "max", "type": "number", "description": "最大值。" },
    { "name": "step", "type": "number", "default": 1, "description": "增减步长。" },
    { "name": "precision", "type": "number", "description": "提交精度。" },
    { "name": "parser", "type": "InputNumberParser", "description": "解析编辑文本。" },
    { "name": "formatter", "type": "InputNumberFormatter", "description": "格式化展示文本。" },
    {
      "name": "keyboard",
      "type": "boolean",
      "default": true,
      "description": "是否允许方向键步进。"
    },
    { "name": "controls", "type": "boolean", "default": true, "description": "是否显示增减操作。" },
    {
      "name": "clearable",
      "type": "boolean",
      "default": false,
      "description": "有值且交互时显示清除操作。"
    },
    { "name": "prefix", "type": "FrameworkNode", "description": "起始内容。" },
    { "name": "suffix", "type": "FrameworkNode", "description": "结束内容，不替换增减操作。" },
    {
      "name": "classNames",
      "type": "Partial<Record<InputNumberPart, string>>",
      "description": "各结构区域 class。"
    },
    {
      "name": "styles",
      "type": "Partial<Record<InputNumberPart, FrameworkStyle>>",
      "description": "各结构区域原生 style。"
    }
  ],
  "events": [
    {
      "name": "change",
      "parameters": [
        { "name": "event", "type": "Event" },
        { "name": "value", "type": "number | undefined" }
      ],
      "description": "返回原始事件与最新 number。"
    }
  ],
  "frameworks": {
    "react": {
      "typeOverrides": { "FrameworkNode": "ReactNode", "FrameworkStyle": "CSSProperties" }
    },
    "vue": { "typeOverrides": { "FrameworkNode": "Slots", "FrameworkStyle": "StyleValue" } },
    "solid": {
      "typeOverrides": { "FrameworkNode": "JSX.Element", "FrameworkStyle": "JSX.CSSProperties" }
    },
    "svelte": { "typeOverrides": { "FrameworkNode": "Snippet", "FrameworkStyle": "string" } },
    "angular": {
      "typeOverrides": { "FrameworkNode": "content projection", "FrameworkStyle": "string" }
    }
  },
  "cssVariables": [],
  "demos": [
    { "id": "basic" },
    { "id": "constraints" },
    { "id": "formatter" },
    { "id": "editing" },
    { "id": "controls" },
    { "id": "keyboard" },
    { "id": "range" },
    { "id": "custom-logic" },
    { "id": "affixes" },
    { "id": "validation" },
    { "id": "semantic-styles" }
  ]
}
