{
  "name": "Select",
  "slug": "select",
  "layer": "primitive",
  "status": "stable",
  "description": "可组合的单选与多选 Primitive。",
  "importPath": {
    "react": "@fex-design/react/primitive/select",
    "vue": "@fex-design/vue/primitive/select",
    "solid": "@fex-design/solid/primitive/select",
    "svelte": "@fex-design/svelte/primitive/select",
    "angular": "@fex-design/angular/primitive/select"
  },
  "components": [
    {
      "name": "SelectRoot",
      "layer": "primitive",
      "description": "管理选中、展开和搜索状态。",
      "props": []
    },
    {
      "name": "SelectTrigger",
      "layer": "primitive",
      "description": "连接输入控件与弹层触发器。",
      "props": []
    },
    {
      "name": "SelectValue",
      "layer": "primitive",
      "description": "渲染当前值或占位内容。",
      "props": []
    },
    {
      "name": "SelectContent",
      "layer": "primitive",
      "description": "弹层内容和项目列表容器。",
      "props": []
    },
    { "name": "SelectItem", "layer": "primitive", "description": "可选项目。", "props": [] },
    { "name": "SelectGroup", "layer": "primitive", "description": "项目分组。", "props": [] },
    { "name": "SelectLabel", "layer": "primitive", "description": "分组标题。", "props": [] },
    { "name": "SelectSeparator", "layer": "primitive", "description": "项目分隔线。", "props": [] }
  ],
  "props": [
    { "name": "options", "type": "readonly SelectOption[]", "description": "动态选项列表。" },
    { "name": "value", "type": "SelectionValue | SelectionValue[]", "description": "受控选中值。" },
    {
      "name": "defaultValue",
      "type": "SelectionValue | SelectionValue[]",
      "description": "非受控初始值。"
    },
    {
      "name": "multiple",
      "type": "boolean",
      "default": false,
      "description": "启用多选。",
      "editor": "boolean"
    },
    {
      "name": "showSearch",
      "type": "boolean",
      "default": false,
      "description": "使 Trigger 可输入搜索。",
      "editor": "boolean"
    },
    {
      "name": "filterOption",
      "type": "SelectFilterOption | false",
      "description": "自定义本地过滤或关闭本地过滤。"
    },
    { "name": "open", "type": "boolean", "description": "受控展开状态。" },
    {
      "name": "defaultOpen",
      "type": "boolean",
      "default": false,
      "description": "非受控初始展开状态。"
    },
    { "name": "onOpenChange", "type": "(open: boolean) => void", "description": "展开状态变化。" },
    { "name": "virtual", "type": "SelectVirtualOptions", "description": "固定行高虚拟化配置。" }
  ],
  "events": [
    { "name": "change", "type": "(value, meta) => void", "description": "选择变化。" },
    { "name": "search", "type": "(keyword: string) => void", "description": "搜索输入变化。" }
  ],
  "cssVariables": [],
  "demos": [
    { "id": "basic", "title": "基础组合", "description": "组合 Root、Trigger 与 Content。" },
    { "id": "single", "title": "单选", "description": "组合单选值与受控变化。" },
    { "id": "controlled", "title": "受控与非受控", "description": "对比 value 与 open 的受控状态和非受控初始值。" },
    { "id": "multiple", "title": "多选", "description": "组合多选值、标签和最大数量。" },
    { "id": "field-names", "title": "字段映射", "description": "把 profileId 映射为 value，把 displayName 映射为 label。" },
    { "id": "group", "title": "分组", "description": "组合选项分组。" },
    { "id": "local-search", "title": "本地搜索", "description": "过滤本地选项。" },
    { "id": "remote-search", "title": "远程搜索", "description": "模拟异步接口、加载状态与连续请求竞态处理。" },
    { "id": "custom-search", "title": "自定义搜索", "description": "使用字符顺序匹配；输入 rt 可以匹配 React。" },
    { "id": "clear", "title": "清除", "description": "清除当前选中值。" },
    { "id": "empty-demo", "title": "空状态", "description": "显示自定义空状态。" },
    { "id": "popup-render-demo", "title": "自定义面板", "description": "扩展下拉面板。" },
    { "id": "prefix-suffix-demo", "title": "前后缀", "description": "自定义 Trigger 前后缀。" },
    { "id": "direction", "title": "LTR 与 RTL", "description": "对比双向布局。" },
    { "id": "semantic-styles", "title": "结构化样式", "description": "定制语义部位样式。" },
    { "id": "css-variables", "title": "CSS 变量", "description": "通过 CSS 变量定制 Select。" },
    { "id": "virtual", "title": "虚拟列表", "description": "只渲染可视区项目。" }
  ]
}
